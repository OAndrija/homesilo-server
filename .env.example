# Copy to .env and fill in. Never commit .env.

# Required
DB_PASSWORD=change-me
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Optional (defaults shown)
HOMESILO_PORT=8080
# Set to true once HomeSilo is served over HTTPS (e.g. behind a TLS reverse proxy).
COOKIE_SECURE=false
# The first account to register always becomes admin. Set to false afterwards to close sign-ups.
REGISTRATION_ENABLED=true
DEFAULT_QUOTA=100GB
MAX_UPLOAD_SIZE=5GB
# Days before trashed items are deleted automatically; 0 keeps them forever.
TRASH_RETENTION_DAYS=30
JWT_EXPIRATION=7d
