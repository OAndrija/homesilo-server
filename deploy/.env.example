# HomeSilo settings. Copy to .env next to docker-compose.yml.
# Only DB_PASSWORD is required.

# Password for HomeSilo's own database. Anything long and random:
#   openssl rand -base64 32
DB_PASSWORD=

# Which release to run. "1" follows 1.x, so `docker compose pull` brings fixes
# and features but never a release that needs you to do something first. Pin
# an exact version (1.4.2) if you'd rather choose every update yourself.
HOMESILO_VERSION=1

# Where HomeSilo listens on this machine.
HOMESILO_PORT=8080
#HOMESILO_BIND=0.0.0.0

# ── Accounts and storage ─────────────────────────────────────────────────────

# The storage, trash and sign-up values here are only starting points: once an
# admin changes them on the Server page, the page wins.

# Storage for each new account. Admins can change it per person.
#DEFAULT_QUOTA=100GB
# Largest single file.
#MAX_UPLOAD_SIZE=5GB
# Days before the trash empties itself. 0 keeps things forever.
#TRASH_RETENTION_DAYS=30
# Let anyone create an account. Off by default: people join with invite links.
#REGISTRATION_ENABLED=false
# The code that creates the first admin. By default a random one is printed in
# the server log; set your own for an automated install (12+ letters or digits).
#SETUP_CODE=

# ── Backups (see docs/backups.md) ────────────────────────────────────────────

# When the database is backed up (second minute hour day month weekday), and
# how many backups to keep.
#BACKUP_CRON=0 0 2 * * *
#BACKUP_KEEP=7
#BACKUP_ENABLED=true

# ── Remote access (see docs/remote-access.md) ────────────────────────────────

# Cloudflare Tunnel: the token from the Zero Trust dashboard.
#TUNNEL_TOKEN=
# Caddy: the domain HomeSilo is served on, pointed at this machine.
#HOMESILO_DOMAIN=drive.example.com

# ── Rarely needed ────────────────────────────────────────────────────────────

# Memory for the server. 1g suits a household; give it more for many users.
#HOMESILO_MEMORY=1g
# The network HomeSilo's containers share. Change only if it clashes with yours.
#HOMESILO_SUBNET=172.30.80.0/24
# Set only to override the defaults: a signing key is generated and kept with
# your files, and session cookies need HTTPS whenever the connection is HTTPS.
#JWT_SECRET=
#COOKIE_SECURE=
